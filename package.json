    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
