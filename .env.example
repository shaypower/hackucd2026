# Copy to .env.local and fill in. One shared set of keys for the whole team:
# ask the repo owner, or once Vercel is set up run `npx vercel env pull .env.local`.
# Never commit real values.

# OpenRouter (AI extraction) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Model slug from https://openrouter.ai/models (chosen and compared in task A5/A9)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Audio-capable model for call transcription
OPENROUTER_AUDIO_MODEL=openai/gpt-audio-mini

# Supabase - dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Server-only (bypasses RLS). Never import it in client components or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Only for `npm run db:push` (migrations + seed). Supabase > Connect > Session pooler URI, password percent-encoded.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Stripe sandbox (test mode keys only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxx
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook` (per person)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Twilio phone line (console.twilio.com). Point the number's "A call comes in" webhook at
# POST https://<your-deployment>/api/twilio/voice
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
# Shown on the desk
NEXT_PUBLIC_TELDEAL_PHONE=+15550100000
# Optional: public base URL if signature checks fail behind a proxy (e.g. https://hackucd2026.vercel.app)
TWILIO_WEBHOOK_BASE_URL=

# Base URL used for Stripe redirect links
NEXT_PUBLIC_APP_URL=http://localhost:3000
